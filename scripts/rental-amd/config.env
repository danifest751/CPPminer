# Settings for the R9700 kit scripts. Edit here, or override per run from the environment
# (e.g. DEVICES=1 ./bench.sh).

# Kryptex account (the same wallet the home miners use).
WALLET=${WALLET:-krxX8QJ872}
# Worker name prefix: GPU N mines as ${WORKER}-pearl-N / ${WORKER}-qtc-N.
WORKER=${WORKER:-r9700}

# Pools. The -ru hosts by default: they work from anywhere, while long share submits to the
# EU hosts are dropped from Russian networks (prl.kryptex.network / qtc.kryptex.network for EU).
PEARL_POOL=${PEARL_POOL:-stratum+tcp://prl-ru.kryptex.network:7048}
QTC_POOL=${QTC_POOL:-stratum+tcp://qtc-ru.kryptex.network:7049}

# OpenCL device indices to use (cppminer --backend opencl --list-devices shows them).
# Empty = every AMD device found.
DEVICES=${DEVICES:-}

# Extra environment for the miner processes, e.g. PEARL_ENV="CP_OCL_WMMA_PIPELINE=0" if
# bench.sh shows that variant is faster on this card. Several settings, one with spaces:
#   PEARL_ENV='CP_OCL_WMMA_WAVE_N=32 "CP_OCL_EXTRA_OPTS=-DCASE32_WMMA_LDS=1 -DCASE32_WMMA_KUNROLL=1"'
#   QTC_ENV='"CP_QPOW_OCL_OPTS=-DQV_NPW=2"'
PEARL_ENV=${PEARL_ENV:-}
QTC_ENV=${QTC_ENV:-}

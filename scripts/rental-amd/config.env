# Settings for the R9700 kit scripts. Edit here, or override per run from the environment
# (e.g. DEVICES=1 ./bench.sh).

# Kryptex account (the same wallet the home miners use).
WALLET=${WALLET:-krxX8QJ872}
# Worker name prefix: GPU N mines as ${WORKER}-pearl-N / ${WORKER}-qtc-N.
WORKER=${WORKER:-r9700}

# Pools. EU hosts by default; for a server in Russia use prl-ru / qtc-ru.kryptex.network.
PEARL_POOL=${PEARL_POOL:-stratum+tcp://prl.kryptex.network:7048}
QTC_POOL=${QTC_POOL:-stratum+tcp://qtc.kryptex.network:7049}

# OpenCL device indices to use (cppminer --backend opencl --list-devices shows them).
# Empty = every AMD device found.
DEVICES=${DEVICES:-}

# Extra environment for the miner processes, e.g. PEARL_ENV="CP_OCL_WMMA_PIPELINE=0" if
# bench.sh shows that variant is faster on this card.
PEARL_ENV=${PEARL_ENV:-}
QTC_ENV=${QTC_ENV:-}
